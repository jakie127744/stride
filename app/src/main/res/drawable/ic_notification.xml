<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification icon. Android renders these from the alpha channel only (ignores
     RGB), so this just needs to be a simple filled silhouette per notification icon guidelines
     — a running-figure abstraction (dot + stride line), not the full-color launcher mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9,4 m-2,0 a2,2 0,1,1 4,0 a2,2 0,1,1 -4,0" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M5,20 C8,20 7,15 10,13.5 S15,12 16,8"
        android:fillColor="#00000000" />
</vector>
