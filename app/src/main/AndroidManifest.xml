<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requested contextually, not all at once — see docs/foundation.md permission approach.
         Declared here because manifest declaration is required regardless of when the runtime
         prompt actually fires. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".StrideApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Stride"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Stride">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the process alive during an active session so RunSessionEngine's voice cues
             and GPS tracking survive the app being backgrounded — see RunSessionService and
             docs/roadmap.md. type="location" because that's the service's real core function
             (GPS tracking); voice cues via TextToSpeech aren't "media playback" in the Play
             Store review sense, so foregroundServiceTypeMediaPlayback isn't declared here to
             avoid misrepresenting what this service does. The real Media3 MediaSessionService
             in Phase 4 will legitimately need that type when it lands. -->
        <service
            android:name=".run.RunSessionService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
