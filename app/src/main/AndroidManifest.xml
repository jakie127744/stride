<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requested contextually, not all at once — see docs/foundation.md permission approach.
         Declared here because manifest declaration is required regardless of when the runtime
         prompt actually fires. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- RunSessionService's fallback type when it's keeping a treadmill session (or an outdoor
         session where location permission was denied) alive — Android 14+ prohibits declaring
         no type at all, so this covers "no real GPS work, still needs a real FGS type". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 5 — see core:health/HealthConnectRepository. Every call site is best-effort and
         degrades gracefully with no permission granted (or Health Connect not installed at all),
         same as every other permission-gated feature in this app. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Required for HealthConnectClient.getSdkStatus() to actually detect whether the Health
         Connect provider app is installed, rather than always reporting unavailable — package
         visibility (Android 11+) hides other apps' presence by default without this. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".StrideApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Stride"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Stride">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the process alive during an active session so RunSessionEngine's GPS tracking
             survives the app being backgrounded — see RunSessionService and docs/roadmap.md.
             Declares BOTH types it can legitimately start as: "location" for real outdoor GPS
             work, "dataSync" as the fallback for treadmill sessions (no GPS at all) or an
             outdoor session where location permission was denied (found by running this
             on-device: Android 14+ requires a real declared type, "none" is itself prohibited —
             RunSessionService.onCreate() picks which declared type to actually start with based
             on current permission state). Voice cues live in their own real media-session
             service below (Phase 4) rather than being declared here. -->
        <service
            android:name=".run.RunSessionService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />

        <!-- The real Phase 4 audio engine — see RunAudioService's doc comment for why this is a
             second service rather than folded into RunSessionService above (Service and
             MediaSessionService can't be multiply inherited). type="mediaPlayback" is honest
             here: this service's actual job is hosting an active MediaSession + ExoPlayer. -->
        <service
            android:name=".audio.RunAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
